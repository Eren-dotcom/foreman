  "source": "pragma solidcash ^0.51.1;\n\n// ChunkPod — the SolidCash port of the Foreman covenant.\n// Same rules, same fee budgets, same three spend paths as ChunkPod.cash.\ncontract ChunkPod(bytes20 clientPkh, bytes20 providerPkh, int chunkSize, int windowSize, int validUntil) {\n    int constant FEE = 700;\n    int constant REFUND_FEE = 600;\n\n    // The provider pulls payment for whole chunks.\n    function deliver(pubkey providerPk, sig providerSig) {\n        require(hash160(providerPk) == providerPkh);\n        require(checkSig(providerSig, providerPk));\n        require(tx.inputs.length == 1);\n\n        int held = tx.inputs[this.activeInputIndex].value;\n        int paid = tx.outputs[0].value;\n\n        require(paid >= chunkSize);\n        require(paid <= windowSize);\n        require(paid % chunkSize == 0);\n        require(held >= paid + FEE);\n\n        bytes25 providerLockingBytecode = new LockingBytecodeP2PKH(providerPkh);\n        require(tx.outputs[0].lockingBytecode == providerLockingBytecode);\n\n        require(tx.outputs.length == 2);\n        require(tx.outputs[1].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);\n        require(tx.outputs[1].value == held - paid - FEE);\n    }\n\n    // After expiry the client takes back whatever is left.\n    function refund(pubkey clientPk, sig clientSig) {\n        require(hash160(clientPk) == clientPkh);\n        require(checkSig(clientSig, clientPk));\n        require(tx.time >= validUntil);\n        require(tx.inputs.length == 1);\n\n        bytes25 clientLockingBytecode = new LockingBytecodeP2PKH(clientPkh);\n        require(tx.outputs.length == 1);\n        require(tx.outputs[0].lockingBytecode == clientLockingBytecode);\n        require(tx.outputs[0].value == tx.inputs[this.activeInputIndex].value - REFUND_FEE);\n    }\n}\n",
